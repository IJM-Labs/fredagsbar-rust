{
  "openapi": "3.0.3",
  "info": {
    "title": "Fredagsbarens Event API",
    "description": "API til events og tilmeldinger i fredagsbaren.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5001",
      "description": "Lokal Flask-server"
    }
  ],
  "paths": {
    "/events": {
      "get": {
        "summary": "Hent alle events",
        "responses": {
          "200": {
            "description": "En liste med alle events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Opret et nyt event",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewEvent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Eventet blev oprettet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "JSON mangler, eller eventets oplysninger er ugyldige",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}": {
      "parameters": [
        {
          "name": "event_id",
          "in": "path",
          "required": true,
          "description": "ID på eventet",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Hent et event ud fra ID",
        "responses": {
          "200": {
            "description": "Eventet blev fundet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "404": {
            "description": "Eventet findes ikke",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "eventet findes ikke"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Slet et event",
        "responses": {
          "204": {
            "description": "Eventet blev slettet"
          },
          "404": {
            "description": "Eventet findes ikke",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "eventet findes ikke"
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}/signups": {
      "parameters": [
        {
          "name": "event_id",
          "in": "path",
          "required": true,
          "description": "ID på eventet",
          "schema": {
            "type": "integer"
          }
        }
      ],
      "post": {
        "summary": "Tilmeld en person til et event",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signup"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Personen blev tilmeldt, og det opdaterede event returneres",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "JSON eller name mangler",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "missingJson": {
                    "value": {
                      "error": "requesten skal indeholde JSON"
                    }
                  },
                  "missingName": {
                    "value": {
                      "error": "name er påkrævet"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Eventet findes ikke",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "eventet findes ikke"
                }
              }
            }
          },
          "409": {
            "description": "Eventet er fuldt, eller personen er allerede tilmeldt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "alreadySignedUp": {
                    "value": {
                      "error": "personen er allerede tilmeldt eventet"
                    }
                  },
                  "eventFull": {
                    "value": {
                      "error": "eventet er fuldt"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/events/{event_id}/signups/{name}": {
      "parameters": [
        {
          "name": "event_id",
          "in": "path",
          "required": true,
          "description": "ID på eventet",
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "name",
          "in": "path",
          "required": true,
          "description": "Navnet på personen, der skal afmeldes",
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "summary": "Afmeld en person fra et event",
        "responses": {
          "204": {
            "description": "Personen blev afmeldt"
          },
          "404": {
            "description": "Eventet eller tilmeldingen findes ikke",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "eventNotFound": {
                    "value": {
                      "error": "eventet findes ikke"
                    }
                  },
                  "signupNotFound": {
                    "value": {
                      "error": "personen er ikke tilmeldt eventet"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "required": [
          "id",
          "title",
          "date",
          "capacity",
          "participants"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "example": "Quizaften"
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2023-11-15"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "example": 3
          },
          "participants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "osman",
              "jeppe"
            ]
          }
        }
      },
      "NewEvent": {
        "type": "object",
        "required": [
          "title",
          "date",
          "capacity"
        ],
        "properties": {
          "title": {
            "type": "string",
            "example": "Karaokeaften"
          },
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-12-04"
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "example": 10
          }
        }
      },
      "Signup": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "osman"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "eventet findes ikke"
          }
        }
      }
    }
  }
}